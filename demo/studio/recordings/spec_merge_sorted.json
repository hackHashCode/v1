{
"task": "Write a function to merge two sorted lists into one sorted list.",
"tests": [
"assert merge_sorted([1, 3], [2, 4]) == [1, 2, 3, 4]",
"assert merge_sorted([], [1, 2]) == [1, 2]",
"assert merge_sorted([1, 2, 3], []) == [1, 2, 3]",
"assert merge_sorted([1, 1], [1]) == [1, 1, 1]",
"assert merge_sorted([5, 6], [1, 2]) == [1, 2, 5, 6]",
"assert merge_sorted([1, 4, 9], [2, 3]) == [1, 2, 3, 4, 9]",
"assert merge_sorted([-2, 0], [-1]) == [-2, -1, 0]",
"assert merge_sorted([], []) == []"
],
"reference": "def merge_sorted(a, b):\n    i = j = 0; out = []\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]: out.append(a[i]); i += 1\n        else: out.append(b[j]); j += 1\n    return out + a[i:] + b[j:]",
